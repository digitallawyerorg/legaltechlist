/ locals: path, title, description, meta (optional), visual_html (required), heading_tag (optional)
- heading_tag = local_assigns.fetch(:heading_tag, "h3")
= link_to path, class: "stats-index-card" do
    = content_tag(heading_tag, title, class: "stats-index-card-title")
    p.stats-index-card-desc= description
    .stats-index-card-visual
        == visual_html
    .stats-index-card-footer
        - if local_assigns[:meta].present?
            span.stats-index-card-meta= meta
        span.stats-index-card-action
            | View analysis
            i.fas.fa-arrow-right aria-hidden="true"
